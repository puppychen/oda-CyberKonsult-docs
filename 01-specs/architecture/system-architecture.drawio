        <!-- NestJS 內部模組列表 -->
        <mxCell id="nestjs-modules" value="&lt;div style=&quot;text-align:left;font-size:9px;&quot;&gt;&lt;b&gt;模組：&lt;/b&gt;&lt;br&gt;auth（JWT+RBAC+密碼政策） │ users（CRUD+角色） │ chat（RAG+LLM+SSE+回饋）&lt;br&gt;prompts（範本CRUD+測試） │ audit（日誌+匯出） │ cleaning（代理→FastAPI）&lt;br&gt;datasources（GDrive 代理） │ websearch（SearXNG+WebFetcher） │ health（DB+RAG 探針）&lt;br&gt;llm（Gemini/OpenAI @Global） │ websocket（Socket.io 任務推播）&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDF3;strokeColor=#6C8EBF;fontSize=9;fontFamily=Noto Sans TC;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="220" y="470" width="320" height="100" as="geometry" />
        </mxCell>

        <!-- 安全機制標示 -->
        <mxCell id="security-box" value="&lt;div style=&quot;text-align:left;font-size:9px;&quot;&gt;&lt;b&gt;🔒 安全機制：&lt;/b&gt;&lt;br&gt;• JWT (access+refresh) + bcrypt 12r&lt;br&gt;• 資通安全「普」級密碼政策&lt;br&gt;• RBAC @Roles Guard&lt;br&gt;• ThrottlerModule 60req/min&lt;br&gt;• ValidationPipe + 50MB 上傳限制&lt;br&gt;• PasswordChangeRequired Guard&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;fontFamily=Noto Sans TC;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="400" width="240" height="110" as="geometry" />
        </mxCell>

        <!-- FastAPI RAG Service -->
        <mxCell id="fastapi-box" value="&lt;b&gt;FastAPI RAG Service&lt;/b&gt;&lt;br&gt;Python 3.12+ (uv)&lt;br&gt;port: 8000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="830" y="400" width="320" height="60" as="geometry" />
        </mxCell>

        <!-- FastAPI 內部模組列表 -->
        <mxCell id="fastapi-modules" value="&lt;div style=&quot;text-align:left;font-size:9px;&quot;&gt;&lt;b&gt;功能模組：&lt;/b&gt;&lt;br&gt;upload（檔案上傳+ZIP解壓） │ clean（PII偵測+去識別化） │ preview（清洗預覽）&lt;br&gt;review（Maker-Checker 審核流程） │ ingest（向量化+Qdrant入庫）&lt;br&gt;tasks（任務管理） │ download（結果下載） │ analytics（統計儀表板）&lt;br&gt;knowledge-base（KB瀏覽+語意搜尋） │ gdrive（Google Drive同步）&lt;br&gt;&lt;b&gt;核心引擎：&lt;/b&gt; Presidio+spaCy（20種PII） │ Hybrid Search（Vector+BM25+RRF） │ Reranker&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#D6B656;fontSize=9;fontFamily=Noto Sans TC;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="830" y="470" width="350" height="110" as="geometry" />
        </mxCell>

