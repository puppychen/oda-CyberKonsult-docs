      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 標題 -->
        <mxCell id="dm-title" value="&lt;b&gt;ODA Cyber Konsult — 資料模型與雙 ORM 架構&lt;/b&gt;&lt;br&gt;PostgreSQL 17 共用實例・Prisma (NestJS) + SQLAlchemy/Alembic (Python)" style="text;html=1;fontSize=14;fontFamily=Noto Sans TC;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="250" y="10" width="700" height="50" as="geometry" />
        </mxCell>

        <!-- Prisma 管理區域 -->
        <mxCell id="prisma-group" value="&lt;b&gt;Prisma ORM（NestJS 端管理）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontFamily=Noto Sans TC;verticalAlign=top;spacingTop=5;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="540" height="480" as="geometry" />
        </mxCell>

        <!-- users -->
        <mxCell id="t-users" value="&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;&lt;b&gt;users&lt;/b&gt;&lt;br&gt;─────────────────&lt;br&gt;id: UUID (PK)&lt;br&gt;email: String (unique)&lt;br&gt;password: String (bcrypt)&lt;br&gt;name: String&lt;br&gt;role: Enum (7種角色)&lt;br&gt;isActive: Boolean&lt;br&gt;failedLoginAttempts: Int&lt;br&gt;lockedUntil: DateTime?&lt;br&gt;mustChangePassword: Boolean&lt;br&gt;passwordLastChangedAt: DateTime&lt;br&gt;createdAt / updatedAt&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=10;fontFamily=Noto Sans TC;align=left;spacingLeft=8;" vertex="1" parent="1">
