        <mxCell id="rp-title" value="&lt;b&gt;ODA Cyber Konsult — 角色權限矩陣&lt;/b&gt;&lt;br&gt;RBAC 7 角色 × 3 應用 × 功能存取" style="text;html=1;fontSize=14;fontFamily=Noto Sans TC;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="600" height="45" as="geometry" />
        </mxCell>

        <!-- 角色表格 -->
        <mxCell id="role-table" value="&lt;table style=&quot;font-size:11px;font-family:Noto Sans TC;border-collapse:collapse;width:100%;&quot;&gt;&lt;tr style=&quot;background:#6C8EBF;color:white;&quot;&gt;&lt;th style=&quot;padding:6px;border:1px solid #ccc;width:140px;&quot;&gt;角色&lt;/th&gt;&lt;th style=&quot;padding:6px;border:1px solid #ccc;width:80px;&quot;&gt;Admin&lt;br&gt;(5173)&lt;/th&gt;&lt;th style=&quot;padding:6px;border:1px solid #ccc;width:80px;&quot;&gt;Chatbot&lt;br&gt;(5174)&lt;/th&gt;&lt;th style=&quot;padding:6px;border:1px solid #ccc;width:80px;&quot;&gt;Cleaner&lt;br&gt;(5175)&lt;/th&gt;&lt;th style=&quot;padding:6px;border:1px solid #ccc;width:130px;&quot;&gt;預設模式&lt;/th&gt;&lt;th style=&quot;padding:6px;border:1px solid #ccc;width:180px;&quot;&gt;可切換模式&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;&quot;&gt;&lt;b&gt;admin&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;text-align:center;background:#d5e8d4;&quot;&gt;✅ 全部&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;text-align:center;background:#d5e8d4;&quot;&gt;✅&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;text-align:center;background:#d5e8d4;&quot;&gt;✅ 全部&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;&quot;&gt;standard&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;&quot;&gt;beginner / standard / expert&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f9f9f9;&quot;&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;&quot;&gt;&lt;b&gt;data_reviewer&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;text-align:center;background:#f8cecc;&quot;&gt;❌&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;text-align:center;background:#d5e8d4;&quot;&gt;✅&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;text-align:center;background:#d5e8d4;&quot;&gt;✅ 審核+送入&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;&quot;&gt;standard&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;&quot;&gt;beginner / standard&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;&quot;&gt;&lt;b&gt;data_cleaner&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;text-align:center;background:#f8cecc;&quot;&gt;❌&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;text-align:center;background:#d5e8d4;&quot;&gt;✅&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;text-align:center;background:#d5e8d4;&quot;&gt;✅ 編輯+送審&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;&quot;&gt;standard&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;&quot;&gt;beginner / standard&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f9f9f9;&quot;&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;&quot;&gt;&lt;b&gt;consultant&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;text-align:center;background:#f8cecc;&quot;&gt;❌&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;text-align:center;background:#d5e8d4;&quot;&gt;✅&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;text-align:center;background:#f8cecc;&quot;&gt;❌&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;&quot;&gt;expert&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;&quot;&gt;beginner / standard / expert&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;&quot;&gt;&lt;b&gt;it_user&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;text-align:center;background:#f8cecc;&quot;&gt;❌&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;text-align:center;background:#d5e8d4;&quot;&gt;✅&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;text-align:center;background:#f8cecc;&quot;&gt;❌&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;&quot;&gt;standard&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;&quot;&gt;beginner / standard&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f9f9f9;&quot;&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;&quot;&gt;&lt;b&gt;user&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;text-align:center;background:#f8cecc;&quot;&gt;❌&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;text-align:center;background:#d5e8d4;&quot;&gt;✅&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;text-align:center;background:#f8cecc;&quot;&gt;❌&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;&quot;&gt;beginner&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;&quot;&gt;beginner / standard&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;&quot;&gt;&lt;b&gt;basic_user&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;text-align:center;background:#f8cecc;&quot;&gt;❌&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;text-align:center;background:#d5e8d4;&quot;&gt;✅&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;text-align:center;background:#f8cecc;&quot;&gt;❌&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;&quot;&gt;beginner&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;&quot;&gt;❌ 不可切換&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=auto;rounded=1;strokeColor=#999999;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="110" y="70" width="980" height="290" as="geometry" />
        </mxCell>

        <!-- Maker-Checker 職責分離說明 -->
        <mxCell id="mc-box" value="&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;&lt;b&gt;🔒 Maker-Checker 職責分離（清洗審核流程）&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Maker（送審者）：&lt;/b&gt;data_cleaner、admin&lt;br&gt;　→ 編輯去識別化內容、管理標籤、送審&lt;br&gt;&lt;br&gt;&lt;b&gt;Checker（審批者）：&lt;/b&gt;data_reviewer、admin&lt;br&gt;　→ 批准/退回任務、送入 RAG 知識庫&lt;br&gt;&lt;br&gt;&lt;b&gt;⚠️ 強制規則：&lt;/b&gt;submitted_by ≠ approved_by（FastAPI 伺服器端驗證）&lt;br&gt;　操作者身份由 NestJS JWT @CurrentUser 注入，不依賴客戶端&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontFamily=Noto Sans TC;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="110" y="390" width="500" height="190" as="geometry" />
        </mxCell>

        <!-- 三層回應模式參數 -->
        <mxCell id="mode-box" value="&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;&lt;b&gt;📊 三層回應模式差異化參數&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;🟢 beginner（新手）：&lt;/b&gt;&lt;br&gt;　topK=3, temp=0.3, maxTokens=1024&lt;br&gt;　白話文、故事化回應&lt;br&gt;&lt;br&gt;&lt;b&gt;🟡 standard（一般）：&lt;/b&gt;&lt;br&gt;　topK=5, temp=0.1, maxTokens=2048&lt;br&gt;　實務技術建議&lt;br&gt;&lt;br&gt;&lt;b&gt;🔴 expert（顧問）：&lt;/b&gt;&lt;br&gt;　topK=8, temp=0.05, maxTokens=4096&lt;br&gt;　Rerank=ON, 含 ISO 條款/法規引用&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontFamily=Noto Sans TC;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="390" width="340" height="220" as="geometry" />
        </mxCell>

