        </mxCell>

        <mxCell id="d9" value="&lt;b&gt;展示完成&lt;/b&gt;&lt;br&gt;Q&amp;A 時間" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="860" y="210" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- 時間估算 -->
        <mxCell id="time-note" value="&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;&lt;b&gt;預估時間：&lt;/b&gt;準備階段 5 分鐘 + 展示 1 約 3 分鐘 + 展示 2 約 3 分鐘 + 展示 3 約 4 分鐘 = 合計約 15 分鐘&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;fontFamily=Noto Sans TC;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="310" width="600" height="30" as="geometry" />
        </mxCell>

      </root>
