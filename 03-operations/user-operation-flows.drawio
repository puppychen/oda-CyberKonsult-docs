<mxfile host="Claude Code" modified="2026-03-24" agent="Claude Code" type="device" version="1.0">
  <diagram id="user-overview" name="1. 使用者操作總覽">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;CyberKonsult 使用者操作總覽流程&lt;/b&gt;&lt;br&gt;從登入到取得 AI 資安顧問回答的完整路徑" style="text;html=1;fontSize=15;fontFamily=Noto Sans TC;align=center;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="350" y="10" width="500" height="45" as="geometry" />
        </mxCell>

        <!-- 主流程箭頭 -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Step 1: 登入 -->
        <mxCell id="s1" value="&lt;b&gt;登入系統&lt;/b&gt;&lt;br&gt;Chatbot UI (5174)&lt;br&gt;Email + 密碼" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Step 2: 角色判定 -->
        <mxCell id="s2" value="&lt;b&gt;角色判定&lt;/b&gt;&lt;br&gt;JWT 解析角色&lt;br&gt;(7 種角色)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="280" y="90" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Step 3: 模式選擇 -->
        <mxCell id="s3" value="&lt;b&gt;模式選擇&lt;/b&gt;&lt;br&gt;依角色顯示可用模式&lt;br&gt;beginner / standard / expert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="480" y="90" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Step 4: 提問 -->
        <mxCell id="s4" value="&lt;b&gt;輸入問題&lt;/b&gt;&lt;br&gt;自然語言提問&lt;br&gt;中英文皆可" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="720" y="90" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Step 5: RAG 檢索 -->
        <mxCell id="s5" value="&lt;b&gt;RAG 智慧檢索&lt;/b&gt;&lt;br&gt;Vector + BM25 混合搜尋&lt;br&gt;依模式調整 topK + rerank" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="920" y="90" width="210" height="60" as="geometry" />
        </mxCell>

        <!-- Step 6: LLM 生成 -->
        <mxCell id="s6" value="&lt;b&gt;AI 回答生成&lt;/b&gt;&lt;br&gt;LLM + 模式提示詞&lt;br&gt;SSE 串流回應" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Step 7: 回應展示 -->
        <mxCell id="s7" value="&lt;b&gt;回應展示&lt;/b&gt;&lt;br&gt;逐字串流顯示&lt;br&gt;引用來源 + 信心度指示器&lt;br&gt;(知識庫/混合/網路)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="310" y="210" width="200" height="75" as="geometry" />
        </mxCell>

        <!-- Step 8: 回饋 -->
        <mxCell id="s8" value="&lt;b&gt;回答回饋&lt;/b&gt;&lt;br&gt;正面/負面&lt;br&gt;記錄至 DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="560" y="220" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- 角色→模式對應表 -->
        <mxCell id="role-table" value="&lt;table style=&quot;font-size:10px;font-family:Noto Sans TC;border-collapse:collapse;&quot;&gt;&lt;tr style=&quot;background:#6C8EBF;color:white;&quot;&gt;&lt;th style=&quot;padding:4px 8px;border:1px solid #ccc;&quot;&gt;角色&lt;/th&gt;&lt;th style=&quot;padding:4px 8px;border:1px solid #ccc;&quot;&gt;預設模式&lt;/th&gt;&lt;th style=&quot;padding:4px 8px;border:1px solid #ccc;&quot;&gt;可切換&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;border:1px solid #ccc;&quot;&gt;basic_user&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border:1px solid #ccc;&quot;&gt;beginner&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border:1px solid #ccc;&quot;&gt;不可切換&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f9f9f9;&quot;&gt;&lt;td style=&quot;padding:3px 8px;border:1px solid #ccc;&quot;&gt;user&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border:1px solid #ccc;&quot;&gt;beginner&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border:1px solid #ccc;&quot;&gt;standard&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;border:1px solid #ccc;&quot;&gt;it_user&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border:1px solid #ccc;&quot;&gt;beginner&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border:1px solid #ccc;&quot;&gt;standard&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f9f9f9;&quot;&gt;&lt;td style=&quot;padding:3px 8px;border:1px solid #ccc;&quot;&gt;consultant&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border:1px solid #ccc;&quot;&gt;expert&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border:1px solid #ccc;&quot;&gt;beginner / standard / expert&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;border:1px solid #ccc;&quot;&gt;admin&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border:1px solid #ccc;&quot;&gt;standard&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border:1px solid #ccc;&quot;&gt;beginner / standard / expert&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=auto;rounded=1;strokeColor=#999999;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="80" y="340" width="400" height="180" as="geometry" />
        </mxCell>

        <!-- 信心度說明 -->
        <mxCell id="conf-note" value="&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;&lt;b&gt;信心度指示器&lt;/b&gt;&lt;br&gt;&lt;br&gt;高信心（綠）：best_score &gt;= 0.7 且無網路搜尋&lt;br&gt;中信心（黃）：best_score 0.3~0.7 或有網路搜尋&lt;br&gt;低信心（紅）：best_score &amp;lt; 0.3 或僅網路搜尋&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;fontFamily=Noto Sans TC;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="340" width="300" height="90" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="three-mode" name="2. 三模式操作對照">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title2" value="&lt;b&gt;三模式操作對照流程&lt;/b&gt;&lt;br&gt;相同問題在不同模式下的回應差異" style="text;html=1;fontSize=15;fontFamily=Noto Sans TC;align=center;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="400" y="10" width="450" height="40" as="geometry" />
        </mxCell>

        <!-- 泳道標題 -->
        <mxCell id="lane-bg" value="&lt;b&gt;新手模式 (beginner)&lt;/b&gt;&lt;br&gt;user 角色" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontFamily=Noto Sans TC;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="380" height="680" as="geometry" />
        </mxCell>
        <mxCell id="lane-st" value="&lt;b&gt;一般模式 (standard)&lt;/b&gt;&lt;br&gt;it_user 角色" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontFamily=Noto Sans TC;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="430" y="60" width="380" height="680" as="geometry" />
        </mxCell>
        <mxCell id="lane-ex" value="&lt;b&gt;顧問模式 (expert)&lt;/b&gt;&lt;br&gt;consultant 角色" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontFamily=Noto Sans TC;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="830" y="60" width="380" height="680" as="geometry" />
        </mxCell>

        <!-- 新手模式內容 -->
        <mxCell id="bg-q" value="&lt;b&gt;問題&lt;/b&gt;&lt;br&gt;什麼是釣魚信件？&lt;br&gt;要怎麼判斷？" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=10;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="320" height="45" as="geometry" />
        </mxCell>
        <mxCell id="bg-param" value="&lt;div style=&quot;text-align:left;font-size:9px;&quot;&gt;&lt;b&gt;參數：&lt;/b&gt;topK=3 | rerank=OFF&lt;br&gt;temp=0.3 | maxTokens=1024&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF0;strokeColor=#82B366;fontSize=9;fontFamily=Noto Sans TC;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="320" height="35" as="geometry" />
        </mxCell>
        <mxCell id="bg-result" value="&lt;div style=&quot;text-align:left;font-size:9px;&quot;&gt;&lt;b&gt;回應特色：&lt;/b&gt;&lt;br&gt;- 白話文說明，用「詐騙電話」比喻&lt;br&gt;- 5 步驟辨識法（條列式）&lt;br&gt;- 台灣企業情境：假供應商/假發票/假 IT 通知&lt;br&gt;- 引用真實新聞案例+統計數據&lt;br&gt;- 提供釣魚信件辨識檢查表&lt;br&gt;&lt;br&gt;&lt;b&gt;來源：&lt;/b&gt;3 份知識庫文件&lt;br&gt;&lt;b&gt;篇幅：&lt;/b&gt;約 300-500 字（簡短）&lt;br&gt;&lt;b&gt;信心度：&lt;/b&gt;高（綠）&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=9;fontFamily=Noto Sans TC;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="320" height="180" as="geometry" />
        </mxCell>
        <mxCell id="bg-key" value="&lt;div style=&quot;text-align:center;font-size:10px;&quot;&gt;&lt;b&gt;核心差異&lt;/b&gt;&lt;br&gt;通俗易懂、情境化、步驟化&lt;br&gt;適合非技術背景使用者&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=10;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="80" y="420" width="280" height="55" as="geometry" />
        </mxCell>

        <!-- 一般模式內容 -->
        <mxCell id="st-q" value="&lt;b&gt;問題&lt;/b&gt;&lt;br&gt;被主管機關發文要出具&lt;br&gt;個資安全維護計畫，怎麼寫？" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=10;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="460" y="110" width="320" height="45" as="geometry" />
        </mxCell>
        <mxCell id="st-param" value="&lt;div style=&quot;text-align:left;font-size:9px;&quot;&gt;&lt;b&gt;參數：&lt;/b&gt;topK=5 | rerank=OFF&lt;br&gt;temp=0.1 | maxTokens=2048&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6C8EBF;fontSize=9;fontFamily=Noto Sans TC;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="170" width="320" height="35" as="geometry" />
        </mxCell>
        <mxCell id="st-result" value="&lt;div style=&quot;text-align:left;font-size:9px;&quot;&gt;&lt;b&gt;回應特色：&lt;/b&gt;&lt;br&gt;- 可交付版本的文件結構大綱（7 章）&lt;br&gt;- 引用個資法施行細則第 12 條（12 項措施）&lt;br&gt;- ISO 27001/27701 架構對照表&lt;br&gt;- 20 項查核清單&lt;br&gt;- 稽核邏輯與常見缺失&lt;br&gt;- 資策會科法所範本資源&lt;br&gt;&lt;br&gt;&lt;b&gt;來源：&lt;/b&gt;5 份知識庫文件&lt;br&gt;&lt;b&gt;篇幅：&lt;/b&gt;約 800-1200 字（中等）&lt;br&gt;&lt;b&gt;信心度：&lt;/b&gt;高（綠）&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=9;fontFamily=Noto Sans TC;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="220" width="320" height="180" as="geometry" />
        </mxCell>
        <mxCell id="st-key" value="&lt;div style=&quot;text-align:center;font-size:10px;&quot;&gt;&lt;b&gt;核心差異&lt;/b&gt;&lt;br&gt;法規引用、可交付範本、查核清單&lt;br&gt;適合 IT/MIS 工程師&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=10;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="480" y="420" width="280" height="55" as="geometry" />
        </mxCell>

        <!-- 顧問模式內容 -->
        <mxCell id="ex-q" value="&lt;b&gt;問題&lt;/b&gt;&lt;br&gt;資安法新法修正&lt;br&gt;哪些條款？" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=10;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="860" y="110" width="320" height="45" as="geometry" />
        </mxCell>
        <mxCell id="ex-param" value="&lt;div style=&quot;text-align:left;font-size:9px;&quot;&gt;&lt;b&gt;參數：&lt;/b&gt;topK=8 | rerank=ON&lt;br&gt;temp=0.05 | maxTokens=4096&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#9673A6;fontSize=9;fontFamily=Noto Sans TC;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="170" width="320" height="35" as="geometry" />
        </mxCell>
        <mxCell id="ex-result" value="&lt;div style=&quot;text-align:left;font-size:9px;&quot;&gt;&lt;b&gt;回應特色：&lt;/b&gt;&lt;br&gt;- 新舊條文逐條對照分析表&lt;br&gt;- 公務機關 vs 非公務機關差異（6 維度）&lt;br&gt;- ISO 27001 條款對應表&lt;br&gt;- 罰則修法前後比較&lt;br&gt;- 顧問輔導客戶注意事項&lt;br&gt;- 程序書修訂位置指引&lt;br&gt;&lt;br&gt;&lt;b&gt;來源：&lt;/b&gt;8 份知識庫文件&lt;br&gt;&lt;b&gt;篇幅：&lt;/b&gt;約 1500-2500 字（詳盡）&lt;br&gt;&lt;b&gt;信心度：&lt;/b&gt;高（綠）&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=9;fontFamily=Noto Sans TC;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="220" width="320" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ex-key" value="&lt;div style=&quot;text-align:center;font-size:10px;&quot;&gt;&lt;b&gt;核心差異&lt;/b&gt;&lt;br&gt;條文對照、跨標準分析、策略建議&lt;br&gt;適合資安顧問&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=10;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="880" y="420" width="280" height="55" as="geometry" />
        </mxCell>

        <!-- 底部技術說明 -->
        <mxCell id="tech-note" value="&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;&lt;b&gt;差異化機制&lt;/b&gt;：相同知識庫文件，透過 topK（檢索深度）+ rerank（精準排序）+ 提示詞範本（回應風格指引）+ temperature（精準度）+ maxTokens（篇幅）五層參數差異化，實現角色適配的回應。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;fontFamily=Noto Sans TC;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="760" width="1180" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="admin-flow" name="3. 知識庫管理流程">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title3" value="&lt;b&gt;知識庫管理操作流程&lt;/b&gt;&lt;br&gt;從文件上傳到 RAG 知識庫的完整 Maker-Checker 流程" style="text;html=1;fontSize=15;fontFamily=Noto Sans TC;align=center;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="350" y="10" width="500" height="40" as="geometry" />
        </mxCell>

        <!-- 箭頭 -->
        <mxCell id="ae1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae5" value="submitted_by != approved_by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#B85450;fontFamily=Noto Sans TC;fontSize=9;fontColor=#B85450;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="a6" target="a7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="a7" target="a8"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- 退回循環 -->
        <mxCell id="ae-reject" value="退回" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;dashed=1;strokeColor=#B85450;fontFamily=Noto Sans TC;fontSize=9;fontColor=#B85450;" edge="1" parent="1" source="a6" target="a4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="320" />
              <mxPoint x="350" y="320" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 1: Admin 上傳 -->
        <mxCell id="a1" value="&lt;b&gt;Admin 登入&lt;/b&gt;&lt;br&gt;Admin Dashboard&lt;br&gt;(5173)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="50" y="80" width="160" height="55" as="geometry" />
        </mxCell>

        <!-- Step 2: 上傳文件 -->
        <mxCell id="a2" value="&lt;b&gt;上傳文件&lt;/b&gt;&lt;br&gt;PDF/DOCX/XLSX/&lt;br&gt;CSV/TXT/ZIP&lt;br&gt;（50MB 上限）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="250" y="75" width="180" height="65" as="geometry" />
        </mxCell>

        <!-- Step 3: 自動清洗 -->
        <mxCell id="a3" value="&lt;b&gt;自動清洗&lt;/b&gt;&lt;br&gt;PII 偵測（20 種）&lt;br&gt;+ 去識別化（6 策略）&lt;br&gt;WebSocket 即時進度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="470" y="70" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Step 4: Cleaner 編輯 -->
        <mxCell id="a4" value="&lt;b&gt;Cleaner 編輯&lt;/b&gt;&lt;br&gt;(data_cleaner)&lt;br&gt;檢視 + 修正 + 標籤" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="270" y="190" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- Step 5: 送審 -->
        <mxCell id="a5" value="&lt;b&gt;送審&lt;/b&gt;&lt;br&gt;Cleaner 送交&lt;br&gt;狀態 → review_requested&lt;br&gt;內容凍結" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="490" y="185" width="200" height="65" as="geometry" />
        </mxCell>

        <!-- Step 6: Reviewer 審核 -->
        <mxCell id="a6" value="&lt;b&gt;Reviewer 審核&lt;/b&gt;&lt;br&gt;(data_reviewer)&lt;br&gt;批准 / 退回&lt;br&gt;Maker-Checker 驗證" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="670" y="185" width="190" height="65" as="geometry" />
        </mxCell>

        <!-- Step 7: 送入設定 -->
        <mxCell id="a7" value="&lt;b&gt;送入設定&lt;/b&gt;&lt;br&gt;額外標籤&lt;br&gt;階層式切塊參數" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="900" y="190" width="170" height="55" as="geometry" />
        </mxCell>

        <!-- Step 8: RAG 知識庫 -->
        <mxCell id="a8" value="&lt;b&gt;送入 RAG 知識庫&lt;/b&gt;&lt;br&gt;向量化 + Qdrant 索引&lt;br&gt;狀態 → ingested&lt;br&gt;結果：files / chunks / vectors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=11;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="1100" y="180" width="230" height="70" as="geometry" />
        </mxCell>

        <!-- 狀態流轉 -->
        <mxCell id="state-flow" value="&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;&lt;b&gt;審批狀態流轉：&lt;/b&gt;&lt;br&gt;pending → review_requested → approved → ingested&lt;br&gt;　　　　　　↓&lt;br&gt;　　　　rejected（退回 → 重新編輯）&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;fontFamily=Noto Sans TC;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="370" width="380" height="65" as="geometry" />
        </mxCell>

        <!-- 角色分工 -->
        <mxCell id="role-div" value="&lt;div style=&quot;text-align:left;font-size:10px;&quot;&gt;&lt;b&gt;Maker-Checker 職責分離：&lt;/b&gt;&lt;br&gt;Maker（送審者）：data_cleaner / admin — 編輯、標籤、送審&lt;br&gt;Checker（審批者）：data_reviewer / admin — 批准、退回、送入&lt;br&gt;規則：submitted_by != approved_by（伺服器端強制驗證）&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;fontFamily=Noto Sans TC;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="370" width="450" height="75" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
