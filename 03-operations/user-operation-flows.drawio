        </mxCell>

        <mxCell id="d1" value="&lt;b&gt;啟動 Docker&lt;/b&gt;&lt;br&gt;PostgreSQL + Qdrant&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;docker compose up -d&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="50" y="80" width="180" height="55" as="geometry" />
        </mxCell>

        <mxCell id="d2" value="&lt;b&gt;啟動服務&lt;/b&gt;&lt;br&gt;pnpm dev&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;NestJS + RAG + 三前端&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="270" y="80" width="180" height="55" as="geometry" />
        </mxCell>

        <mxCell id="d3" value="&lt;b&gt;更新提示詞&lt;/b&gt;&lt;br&gt;pnpm prisma:seed&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;8 組模式範本&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="490" y="80" width="180" height="55" as="geometry" />
        </mxCell>

        <mxCell id="d4" value="&lt;b&gt;匯入知識庫&lt;/b&gt;&lt;br&gt;bash ingest.sh&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;11 份文件 → RAG&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="710" y="80" width="180" height="55" as="geometry" />
