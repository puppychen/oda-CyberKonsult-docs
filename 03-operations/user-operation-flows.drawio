        <mxCell id="d6" value="&lt;b&gt;展示 1：新手模式&lt;/b&gt;&lt;br&gt;登入 user 帳號&lt;br&gt;問：釣魚信件辨識&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;預期：白話+情境+案例&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=10;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="50" y="200" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="d7" value="&lt;b&gt;展示 2：一般模式&lt;/b&gt;&lt;br&gt;登入 it_user 帳號&lt;br&gt;問：個資安全維護計畫&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;預期：法規+範本+清單&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=10;fontFamily=Noto Sans TC;" vertex="1" parent="1">
          <mxGeometry x="320" y="200" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="d8" value="&lt;b&gt;展示 3：顧問模式&lt;/b&gt;&lt;br&gt;登入 consultant 帳號&lt;br&gt;問：資安法修正條款&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;預期：對照+差異+策略&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=10;fontFamily=Noto Sans TC;" vertex="1" parent="1">
