        <mxCell id="de5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="d5" target="d6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="d6" target="d7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="d7" target="d8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="d8" target="d9"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- 準備階段 -->
        <mxCell id="phase-prep" value="&lt;b&gt;準備階段&lt;/b&gt;" style="text;html=1;fontSize=12;fontFamily=Noto Sans TC;fontColor=#666666;" vertex="1" parent="1">
