  <diagram id="customer-role-flow" name="客戶角色與回應層級">
    <mxGraphModel defaultFontFamily="Noto Sans TC" dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;客戶角色單純化與回應層級直接對應&lt;/b&gt;&lt;br&gt;帳號角色只決定可用範圍；所選回應層級直接對應唯一提示詞" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontFamily=Noto Sans TC;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="320" y="20" width="760" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e-start-role" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;" edge="1" parent="1" source="start" target="role-decision"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-role-beginner" value="basic_user" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2F855A;fontFamily=Noto Sans TC;fontSize=14;" edge="1" parent="1" source="role-decision" target="beginner"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-role-general" value="user / it_user→user" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2563EB;fontFamily=Noto Sans TC;fontSize=14;" edge="1" parent="1" source="role-decision" target="general"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-role-consultant" value="consultant" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7C3AED;fontFamily=Noto Sans TC;fontSize=14;" edge="1" parent="1" source="role-decision" target="consultant"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-role-ops" value="admin / cleaner / reviewer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B45309;fontFamily=Noto Sans TC;fontSize=14;" edge="1" parent="1" source="role-decision" target="ops"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-b-select" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;" edge="1" parent="1" source="beginner" target="select"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-g-select" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;" edge="1" parent="1" source="general" target="select"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-c-select" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;" edge="1" parent="1" source="consultant" target="select"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-o-select" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;" edge="1" parent="1" source="ops" target="select"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-select-guard" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;" edge="1" parent="1" source="select" target="guard"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-guard-deny" value="不允許" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C53030;fontColor=#9B2C2C;fontFamily=Noto Sans TC;fontSize=14;" edge="1" parent="1" source="guard" target="deny"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-guard-quota" value="允許" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2F855A;fontColor=#276749;fontFamily=Noto Sans TC;fontSize=14;" edge="1" parent="1" source="guard" target="quota"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-quota-deny" value="Free 額度已滿" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C53030;fontColor=#9B2C2C;fontFamily=Noto Sans TC;fontSize=14;" edge="1" parent="1" source="quota" target="quota-deny"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-quota-prompt" value="額度可用／非 Free" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2F855A;fontColor=#276749;fontFamily=Noto Sans TC;fontSize=14;" edge="1" parent="1" source="quota" target="prompt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-prompt-llm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;" edge="1" parent="1" source="prompt" target="llm"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="start" value="&lt;b&gt;使用者登入 Chatbot&lt;/b&gt;&lt;br&gt;JWT 提供帳號角色" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#52606D;strokeWidth=2;fontSize=16;fontFamily=Noto Sans TC;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="role-decision" value="帳號角色？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B45309;strokeWidth=2;fontSize=16;fontFamily=Noto Sans TC;" vertex="1" parent="1"><mxGeometry x="360" y="110" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="beginner" value="&lt;b&gt;新手／Free&lt;/b&gt;&lt;br&gt;可用：新手&lt;br&gt;預設：新手&lt;br&gt;每日額度預設 20，可後台修改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FFFA;strokeColor=#2F855A;strokeWidth=2;fontSize=15;fontFamily=Noto Sans TC;" vertex="1" parent="1"><mxGeometry x="610" y="100" width="220" height="110" as="geometry" /></mxCell>
        <mxCell id="general" value="&lt;b&gt;一般／Plus&lt;/b&gt;&lt;br&gt;可用：新手、一般&lt;br&gt;預設：一般&lt;br&gt;對象：IT／MIS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#2563EB;strokeWidth=2;fontSize=15;fontFamily=Noto Sans TC;" vertex="1" parent="1"><mxGeometry x="880" y="100" width="220" height="110" as="geometry" /></mxCell>
        <mxCell id="consultant" value="&lt;b&gt;顧問／Pro&lt;/b&gt;&lt;br&gt;可用：新手、一般、顧問&lt;br&gt;預設：顧問" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=2;fontSize=15;fontFamily=Noto Sans TC;" vertex="1" parent="1"><mxGeometry x="1150" y="100" width="220" height="110" as="geometry" /></mxCell>
        <mxCell id="ops" value="&lt;b&gt;既有內部角色維持&lt;/b&gt;&lt;br&gt;admin：三層，預設一般&lt;br&gt;cleaner／reviewer：一般" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B45309;strokeWidth=2;fontSize=15;fontFamily=Noto Sans TC;" vertex="1" parent="1"><mxGeometry x="330" y="280" width="250" height="110" as="geometry" /></mxCell>
        <mxCell id="select" value="&lt;b&gt;選擇回應層級&lt;/b&gt;&lt;br&gt;UI：新手／一般／顧問&lt;br&gt;API：保留 mode 相容名稱" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#52606D;strokeWidth=2;fontSize=16;fontFamily=Noto Sans TC;" vertex="1" parent="1"><mxGeometry x="690" y="300" width="250" height="100" as="geometry" /></mxCell>
        <mxCell id="guard" value="帳號角色允許&lt;br&gt;此回應層級？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B45309;strokeWidth=2;fontSize=16;fontFamily=Noto Sans TC;" vertex="1" parent="1"><mxGeometry x="1020" y="295" width="210" height="115" as="geometry" /></mxCell>
        <mxCell id="deny" value="&lt;b&gt;拒絕請求&lt;/b&gt;&lt;br&gt;HTTP 403&lt;br&gt;前端回復帳號預設層級" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C53030;strokeWidth=2;fontSize=15;fontFamily=Noto Sans TC;" vertex="1" parent="1"><mxGeometry x="1120" y="500" width="230" height="90" as="geometry" /></mxCell>
        <mxCell id="quota" value="&lt;b&gt;檢查每日額度&lt;/b&gt;&lt;br&gt;Free：原子保留 1 次&lt;br&gt;其他角色：略過每日額度&lt;br&gt;設定由 Admin 後台維護" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B45309;strokeWidth=2;fontSize=15;fontFamily=Noto Sans TC;" vertex="1" parent="1"><mxGeometry x="860" y="470" width="240" height="140" as="geometry" /></mxCell>
        <mxCell id="quota-deny" value="&lt;b&gt;額度已用完&lt;/b&gt;&lt;br&gt;HTTP 429&lt;br&gt;回傳剩餘 0 與重設時間" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C53030;strokeWidth=2;fontSize=15;fontFamily=Noto Sans TC;" vertex="1" parent="1"><mxGeometry x="1120" y="660" width="230" height="90" as="geometry" /></mxCell>
        <mxCell id="prompt" value="&lt;b&gt;提示詞一對一直接對應&lt;/b&gt;&lt;br&gt;新手 → beginner prompt&lt;br&gt;一般 → standard prompt&lt;br&gt;顧問 → expert prompt&lt;br&gt;不再查帳號角色" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#2F855A;strokeWidth=2;fontSize=16;fontFamily=Noto Sans TC;" vertex="1" parent="1"><mxGeometry x="560" y="650" width="300" height="140" as="geometry" /></mxCell>
        <mxCell id="llm" value="&lt;b&gt;套用層級參數並產生回答&lt;/b&gt;&lt;br&gt;topK／rerank／temperature／maxTokens&lt;br&gt;既有三層回答深度維持" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#52606D;strokeWidth=2;fontSize=16;fontFamily=Noto Sans TC;" vertex="1" parent="1"><mxGeometry x="200" y="660" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="meta" value="&lt;b&gt;Metadata&lt;/b&gt;&lt;br&gt;Version 0.2｜2026-07-11｜Owner: Jake｜Status: Review&lt;br&gt;保護範圍：Admin、資料清理、資料審查的既有業務權限不變" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=13;fontFamily=Noto Sans TC;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="270" y="850" width="820" height="80" as="geometry" /></mxCell>
      </root>
